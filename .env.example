# ==========================================
# KenDji Luxury — Production Environment Variables
# ==========================================

# Public Storefront URLs & Keys
NEXT_PUBLIC_SITE_URL=https://kendji-luxury.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-Only Supabase Secrets (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Courier / Delivery Integrations (Optional / Server-Only)
COURIER_PROVIDER=MOCK_EXPRESS
YALIDINE_API_KEY=
YALIDINE_API_SECRET=
ZR_EXPRESS_API_KEY=
MAYSTRO_API_KEY=
NOEST_API_KEY=

# Telegram Bot Notifications (Optional / Server-Only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta Tracking & Conversions API (Optional / Server-Only for Token)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
